{
    "name": "systonia/waypoint-export",
    "description": "CSV exports for Waypoint: return an Export from a route and the browser downloads an Excel-friendly file.",
    "type": "library",
    "license": ["MIT", "Apache-2.0"],
    "require": {
        "php": ">=8.5",
        "systonia/waypoint": "^1.4.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Waypoint\\Export\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waypoint\\Export\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --testdox",
        "stan": "phpstan analyse"
    }
}
